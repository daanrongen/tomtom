{
  "name": "tomtom",
  "version": "0.1.3",
  "description": "Unix-friendly CLI for TomTom's location APIs",
  "type": "module",
  "private": true,
  "bin": {
    "tomtom": "./src/cli/main.ts"
  },
  "scripts": {
    "dev": "bun run src/cli/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test test/unit",
    "test:integration": "bun test test/integration",
    "build": "bun build --compile --minify --outfile dist/tomtom src/cli/main.ts"
  },
  "dependencies": {
    "@effect/cli": "^0.77.1",
    "@effect/platform": "^0.97.2",
    "@effect/platform-bun": "^0.91.2",
    "effect": "^3.22.2",
    "smol-toml": "^1.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  }
}
